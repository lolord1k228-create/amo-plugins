def bulletin_info(m):
    try: BulletinHelper.show_info(f"[AMO] {m}")
    except Exception: pass

def bulletin_success(m):
    try: BulletinHelper.show_success(f"[AMO] {m}")
    except Exception: pass

def bulletin_error(m):
    try: BulletinHelper.show_error(f"[AMO] {m}")
    except Exception: pass

def _cute(text, repeats=1, add_heart=True, add_kao=True):
    text = text.strip()
    if not text: return text
    f = text[0]
    if f.isalpha():
        text = "-".join([f] * (repeats + 1)) + text[1:]
    if add_heart: text += random.choice(HEARTS)
    if add_kao: text += random.choice(KAOMOJI)
    return text

def _calc_safe(expr):
    expr = expr.strip().lower()
    for w, o in {"плюс": "+", "минус": "-", "пі": str(math.pi), "пи": str(math.pi)}.items():
        expr = expr.replace(w, o)
    safe = "".join(c for c in expr if c in "0123456789+-*/()., sqrt%^ ")
    safe = safe.replace("^", "**").replace("sqrt", "math.sqrt")
    try: return eval(safe, {"__builtins__": {}, "math": math}, {})
    except Exception: return None

def _to_style(text, style):
    if style == "dot": return "·" + "·".join(text) + "·"
    result = []
    for ch in text:
        c = ord(ch)
        if style == "bold":
            if 65 <= c <= 90: ch = chr(0x1D400 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D41A + c - 97)
        elif style == "italic":
            if 65 <= c <= 90: ch = chr(0x1D434 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D44E + c - 97)
        elif style == "script":
            if 65 <= c <= 90: ch = chr(0x1D49C + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D4B6 + c - 97)
        elif style == "fraktur":
            if 65 <= c <= 90: ch = chr(0x1D504 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D51E + c - 97)
        elif style == "double":
            if 65 <= c <= 90: ch = chr(0x1D538 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D552 + c - 97)
        elif style == "sans":
            if 65 <= c <= 90: ch = chr(0x1D5A0 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D5BA + c - 97)
        elif style == "mono":
            if 65 <= c <= 90: ch = chr(0x1D670 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D68A + c - 97)
        result.append(ch)
    return "".join(result)

class GetUserHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin
    def after_hooked_method(self, param):
        try:
            user = param.getResult()
            if user is None: return
            if int(user.id) in self.plugin.snosed_ids:
                user.first_name = "Deleted Account"
                user.last_name = ""
                user.username = None
                user.deleted = True
                user.premium = True
                try: user.photo = None
                except Exception: pass
        except Exception: pass

class GetBalanceHook(MethodReplacement):
    def __init__(self, plugin): self.plugin = plugin
    def replace_hooked_method(self, param):
        try:
            v = self.plugin.stars_amount
            frac = v - int(v)
            nanos = int((frac * Decimal("1000000000")).to_integral_value())
            nv = Modifier.isAbstract(TL_stars.StarsAmount.getClass().getModifiers())
            amount = TL_stars.StarsAmount.ofStars(int(v)) if nv else TL_stars.StarsAmount(int(v))
            amount.nanos = nanos
            return amount
        except Exception: return None

class InfoButtonHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin
    def after_hooked_method(self, param):
        try:
            if self.plugin.get_setting("enable_info_button", True):
                run_on_ui_thread(lambda: self.plugin._attach_info_button(param.thisObject))
        except Exception: pass

class InfoPauseHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin
    def after_hooked_method(self, param):
        try: run_on_ui_thread(self.plugin._detach_info_button)
        except Exception: pass

class AllMessagesOptions(BasePlugin):
    stars_amount = Decimal("1000")

    def on_plugin_load(self):
        self.spamming = False
        self.snosed_ids = set()
        self.stars_amount = Decimal(self.get_setting("stars_amount", "1000"))
        self.info_btn = None
        self.info_hooks = []
        self.balance_hook_ref = None
        self.last_sent_text = None
        self.store_cache = None  # кеш каталогу

        self.add_on_send_message_hook()
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.DRAWER_MENU,
            text="All Messages Options",
            icon="msg_settings",
            priority=5,
            on_click=self._open_info,
        ))
        if self.get_setting("cmd_snos", True): self._install_snos_hook()
        if self.get_setting("enable_stars", False): self._install_rich_hook()
        self._install_info_hooks()
        log("[AMO] loaded")

    def _install_rich_hook(self):
        try:
            for m in StarsController.getClass().getDeclaredMethods():
                if m.getName() == "getBalance":
                    self.balance_hook_ref = self.hook_method(m, GetBalanceHook(self))
        except Exception as e: log(f"[AMO] rich: {e}")

    def _uninstall_rich_hook(self):
        try:
            if self.balance_hook_ref is not None:
                self.unhook_method(self.balance_hook_ref)
                self.balance_hook_ref = None
        except Exception: pass

    def _install_info_hooks(self):
        try:
            cls = ChatActivity.getClass() if hasattr(ChatActivity, "getClass") else ChatActivity
            for n, h in (("createView", InfoButtonHook), ("onResume", InfoButtonHook), ("onPause", InfoPauseHook)):
                try:
                    m = cls.getDeclaredMethod(n, find_class("android.content.Context")) if n == "createView" else cls.getDeclaredMethod(n)
                    m.setAccessible(True)
                    ref = self.hook_method(m, h(self))
                    if ref: self.info_hooks.append(ref)
                except Exception as e: log(f"[AMO] hook {n}: {e}")
        except Exception as e: log(f"[AMO] info: {e}")

    def _make_info_icon(self, ctx):
        try:
            img = ImageView(ctx)
            img.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            from client_utils import get_media_data_controller
            get_media_data_controller().setPlaceholderImageByIndex(img, "LordGram", 0, "100_100")
            return img
        except Exception: pass
        tv = TextView(ctx)
        tv.setText("ℹ️")
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
        return tv

    def _attach_info_button(self, fragment):
        try:
            if fragment is None or not self.get_setting("enable_info_button", True) or self.info_btn is not None: return
            ev = None
            for f in ("chatActivityEnterView", "chatActivityEnterViewContainer"):
                try:
                    ev = get_private_field(fragment, f)
                    if ev: break
                except Exception: pass
            if ev is None: return
            host = None
            for f in ("attachLayout", "sendButtonContainer", "textFieldContainer"):
                try:
                    host = get_private_field(ev, f)
                    if host: break
                except Exception: pass
            if host is None: return
            try:
                if host.findViewWithTag("__amo_info__") is not None:
                    self.info_btn = host.findViewWithTag("__amo_info__")
                    return
            except Exception: pass
            btn = FrameLayout(host.getContext())
            btn.setTag("__amo_info__")
            icon = self._make_info_icon(host.getContext())
            btn.addView(icon, FrameLayout.LayoutParams(-2, -2, Gravity.CENTER))
            btn.setClickable(True)
            plugin = self
            class _C(dynamic_proxy(View.OnClickListener)):
                def onClick(s, v):
                    try: run_on_ui_thread(lambda: plugin._show_commands_menu(fragment))
                    except Exception: pass
            btn.setOnClickListener(_C())
            if isinstance(host, LinearLayout):
                lp = LinearLayout.LayoutParams(AndroidUtilities.dp(32), AndroidUtilities.dp(32))
                lp.gravity = Gravity.CENTER_VERTICAL
                host.addView(btn, lp)
            else: host.addView(btn)
            self.info_btn = btn
        except Exception as e: log(f"[AMO] attach: {e}")

    def _detach_info_button(self):
        try:
            if self.info_btn is not None and self.info_btn.getParent() is not None:
                self.info_btn.getParent().removeView(self.info_btn)
        except Exception: pass
        self.info_btn = None

    def _show_commands_menu(self, fragment):
        try:
            ctx = fragment.getParentActivity() if fragment else None
            if ctx is None: ctx = ApplicationLoader.applicationContext
            if ctx is None: return

            sheet = BottomSheet(ctx, False)
            scroll = ScrollView(ctx)
            layout = LinearLayout(ctx)
            layout.setOrientation(LinearLayout.VERTICAL)
            layout.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(12),
                             AndroidUtilities.dp(16), AndroidUtilities.dp(24))

            header = LinearLayout(ctx)
            header.setOrientation(LinearLayout.VERTICAL)
            header.setGravity(Gravity.CENTER)
            header.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(16))

            title = TextView(ctx)
            title.setText("All Messages Options")
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
            try:
                title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
                title.setTypeface(AndroidUtilities.bold())
            except Exception: pass
            header.addView(title)

            version = TextView(ctx)
            version.setText(f"v{__version__} • {__author__}")
            version.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            version.setPadding(0, AndroidUtilities.dp(4), 0, 0)
            try:
                version.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            except Exception: pass
            header.addView(version)

            desc = TextView(ctx)
            desc.setText(__description__)
            desc.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
            desc.setPadding(0, AndroidUtilities.dp(6), 0, 0)
            desc.setGravity(Gravity.CENTER)
            try:
                desc.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            except Exception: pass
            header.addView(desc)
            layout.addView(header)

            for section_name, cmds in MENU_SECTIONS:
                section_hdr = TextView(ctx)
                section_hdr.setText(section_name)
                section_hdr.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                section_hdr.setPadding(AndroidUtilities.dp(4), AndroidUtilities.dp(14),
                                       AndroidUtilities.dp(4), AndroidUtilities.dp(6))
                try:
                    section_hdr.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
                    section_hdr.setTypeface(AndroidUtilities.bold())
                except Exception: pass
                layout.addView(section_hdr)

                for cmd_id, cmd_name, args, purpose in cmds:
                    if not self.get_setting(f"cmd_{cmd_id}", True): continue
                    row = LinearLayout(ctx)
                    row.setOrientation(LinearLayout.VERTICAL)
                    row.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(10),
                                   AndroidUtilities.dp(12), AndroidUtilities.dp(10))
                    try:
                        row_bg = GradientDrawable()
                        row_bg.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
                        row_bg.setCornerRadius(float(AndroidUtilities.dp(10)))
                        row.setBackground(row_bg)
                    except Exception: pass

                    cv = TextView(ctx)
                    cv.setText(f"{cmd_name} {args}".strip())
                    cv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                    try:
                        cv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
                    except Exception: pass
                    pv = TextView(ctx)
                    pv.setText(purpose)
                    pv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
                    pv.setPadding(0, AndroidUtilities.dp(2), 0, 0)
                    try:
                        pv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
                    except Exception: pass
                    row.addView(cv); row.addView(pv)

                    class _CmdClick(dynamic_proxy(View.OnClickListener)):
                        def __init__(s, c, cid):
                            super().__init__(); s.c = c; s.cid = cid
                        def onClick(s, v):
                            try:
                                if s.cid == "store":
                                    plugin = self
                                    class _StoreRunnable(dynamic_proxy(Runnable)):
                                        def run(self_obj):
                                            try: plugin._show_store()
                                            except Exception as e: log(f"[AMO] store: {e}")
                                    run_on_ui_thread(_StoreRunnable())
                                    try: sheet.dismiss()
                                    except Exception: pass
                                    return
                                if s.cid == "refresh":
                                    self.store_cache = None
                                    run_on_ui_thread(lambda: bulletin_success("🔄 Каталог оновлено"))
                                    try: sheet.dismiss()
                                    except Exception: pass
                                    return

                                parts = s.c.split()
                                cmd_text = ""
                                for p in parts:
                                    if p.startswith("."):
                                        cmd_text = p
                                        break
                                if not cmd_text: return
                                full_text = cmd_text + " "
                                ev = get_private_field(fragment, "chatActivityEnterView")
                                if ev is None: return
                                edit = None
                                for field in ("messageEditText", "editText"):
                                    try:
                                        edit = get_private_field(ev, field)
                                        if edit is not None: break
                                    except Exception: continue
                                if edit is None: return
                                edit.setText(full_text)
                                edit.setSelection(len(full_text))
                                edit.requestFocus()
                                try: AndroidUtilities.showKeyboard(edit)
                                except Exception: pass
                            except Exception: pass
                            try: sheet.dismiss()
                            except Exception: pass
                    row.setOnClickListener(_CmdClick(cmd_name, cmd_id))

                    lp = LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT
                    )
                    lp.setMargins(0, AndroidUtilities.dp(3), 0, AndroidUtilities.dp(3))
                    layout.addView(row, lp)

            scroll.addView(layout)
            sheet.setCustomView(scroll)
            sheet.show()
        except Exception as e: log(f"[AMO] menu: {e}")

    # ═══════════════════════════════════════════════════════
    #              МАГАЗИН — GitHub API
    # ═══════════════════════════════════════════════════════

    def _fetch_github_files(self):
        """Отримує список файлів у папці plugin/ через GitHub API."""
        try:
            url = _gh_api_url()
            req = urllib.request.Request(url)
            req.add_header("User-Agent", "AMO-Store")
            req.add_header("Accept", "application/vnd.github+json")
            with urllib.request.urlopen(req, timeout=15) as response:
                data = json.loads(response.read().decode("utf-8"))
            if isinstance(data, dict) and "message" in data:
                log(f"[AMO] github error: {data['message']}")
                return None
            return data
        except Exception as e:
            log(f"[AMO] fetch files: {e}")
            return None

    def _parse_meta(self, content):
        """Витягує метадані з .plugin файлу."""
        meta = {}
        for key in ("__id__", "__name__", "__version__", "__author__", "__description__", "__icon__"):
            match = re.search(rf'{key}\s*=\s*["\'](.+?)["\']', content)
            if match:
                meta[key] = match.group(1)
        return meta

    def _download_plugin_content(self, filename):
        """Завантажує повний вміст .plugin файлу."""
        try:
            url = _gh_cdn_url(filename)
            req = urllib.request.Request(url)
            req.add_header("User-Agent", "AMO-Store")
            with urllib.request.urlopen(req, timeout=20) as response:
                return response.read().decode("utf-8", errors="ignore")
        except Exception as e:
            log(f"[AMO] download {filename}: {e}")
            return None

    def _build_store_catalog(self):
        """Будує каталог: список файлів + метадані кожного."""
        files = self._fetch_github_files()
        if not files:
            return None
        catalog = []
        for item in files:
            if item.get("type") != "file":
                continue
            name = item.get("name", "")
            if not name.endswith(".plugin"):
                continue
            if name == "all_messages_options.plugin":
                continue  # не показуємо сам AMO

            content = self._download_plugin_content(name)
            if not content:
                continue

            meta = self._parse_meta(content)
            catalog.append({
                "filename": name,
                "id": meta.get("__id__", name[:-7]),
                "name": meta.get("__name__", name),
                "version": meta.get("__version__", "?"),
                "author": meta.get("__author__", "?"),
                "description": meta.get("__description__", ""),
                "url": _gh_cdn_url(name),
            })
        return catalog

    def _show_store(self):
        """Показує каталог у чаті."""
        run_on_ui_thread(lambda: bulletin_info("📦 Завантажую каталог..."))

        # Використовуємо кеш, якщо є
        if self.store_cache is None:
            self.store_cache = self._build_store_catalog()

        catalog = self.store_cache
        if not catalog:
            run_on_ui_thread(lambda: bulletin_error("Не вдалось завантажити каталог"))
            return

        text = f"📦 Магазин плагінів AMO\nВсього: {len(catalog)}\n\n"
        for p in catalog:
            text += f"• {p['name']} v{p['version']}\n"
            text += f"   Автор: {p['author']}\n"
            if p['description']:
                text += f"   {p['description']}\n"
            text += f"   .install {p['url']}\n\n"

        f = get_last_fragment()
        if f is not None:
            peer = int(f.getDialogId())
            send_text(peer, text)

    def _download_and_open(self, url, peer):
        """Скачує .plugin і відкриває Intent."""
        try:
            filename = url.split("/")[-1].split("?")[0]
            if not filename.endswith(".plugin"):
                filename = "downloaded.plugin"

            save_path = os.path.join("/storage/emulated/0/Download/", filename)

            run_on_ui_thread(lambda: bulletin_info(f"⬇️ {filename}"))
            req = urllib.request.Request(url)
            req.add_header("User-Agent", "AMO-Store")
            with urllib.request.urlopen(req, timeout=30) as response:
                data = response.read()

            with open(save_path, "wb") as f:
                f.write(data)

            run_on_ui_thread(lambda: bulletin_success(f"✅ {len(data)} байт"))

            from android.content import Intent
            from android.net import Uri
            from java.io import File
            ctx = ApplicationLoader.applicationContext
            intent = Intent(Intent.ACTION_VIEW)
            uri = Uri.fromFile(File(save_path))
            intent.setDataAndType(uri, "application/octet-stream")
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            ctx.startActivity(intent)
        except Exception as e:
            log(f"[AMO] install: {e}")
            run_on_ui_thread(lambda: bulletin_error(f"Помилка: {e}"))

    # ═══════════════════════════════════════════════════════

    def _install_snos_hook(self):
        try:
            cls = find_class("org.telegram.messenger.MessagesController")
            if cls is None: return
            for m in cls.getClass().getDeclaredMethods():
                if m.getName() == "getUser":
                    self.hook_method(m, GetUserHook(self))
        except Exception as e: log(f"[AMO] snos: {e}")

    def _open_info(self, ctx):
        run_on_ui_thread(lambda: bulletin_info("All Messages Options v1.2.0"))

    def _save(self, key):
        def _inner(v): self.set_setting(key, str(v))
        return _inner

    def _my_id(self):
        try: return int(UserConfig.getInstance(int(UserConfig.selectedAccount)).getClientUserId())
        except Exception: return 0

    def _on_stars_toggle(self, e):
        if e: self._install_rich_hook()
        else: self._uninstall_rich_hook()

    def _on_info_toggle(self, e):
        if e: run_on_ui_thread(lambda: self._attach_info_button(get_last_fragment()))
        else: run_on_ui_thread(self._detach_info_button)

    def _cute_settings(self):
        try: r = int(self.get_setting("cute_repeats", 0) or 0)
        except Exception: r = 0
        r = max(0, min(r, 4))
        return r, bool(self.get_setting("cute_heart", True)), bool(self.get_setting("cute_kao", True))

    def _get_last_message_text(self, peer):
        if self.last_sent_text: return self.last_sent_text
        try:
            f = get_last_fragment()
            if f is None: return None
            mc = get_messages_controller()
            if mc is None: return None
            lm = mc.getLastMessage(int(f.getDialogId()))
            if lm is None: return None
            text = None
            owner = getattr(lm, "messageOwner", None)
            if owner is not None: text = getattr(owner, "message", None)
            if not text:
                try: text = lm.getMessageText()
                except Exception: text = None
            if text and not str(text).strip().startswith("."):
                return str(text)
        except Exception: pass
        return None

    def _do_spam(self, peer, count, text):
        for i in range(count):
            try: send_text(peer, text)
            except Exception as e: log(f"[AMO] spam: {e}")
            time.sleep(0.3)
        run_on_ui_thread(lambda: bulletin_success(f"✅ Спам завершено: 100% ({count}/{count})"))

    def _do_snos_and_block(self, peer, account):
        try:
            uid = int(peer)
            self.snosed_ids.add(uid)
            try:
                controller = find_class("org.telegram.messenger.MessagesController")
                controller.getInstance(account).blockPeer(jlong(peer))
                run_on_ui_thread(lambda: bulletin_success(f"❄️ Заблоковано + Заморожено: {uid}"))
            except Exception as e:
                log(f"[AMO] block: {e}")
                run_on_ui_thread(lambda: bulletin_error(f"Не вдалось заблокувати: {e}"))
        except Exception as e:
            log(f"[AMO] snos block: {e}")

    def on_send_message_hook(self, account, params):
        try:
            if self.spamming or not isinstance(params.message, str): return HookResult()
            t = params.message
            if not t.startswith("."):
                self.last_sent_text = t
                return HookResult()

            parts = t.split(" ", 1)
            cmd = parts[0][1:].strip().lower()
            args = parts[1].strip() if len(parts) > 1 else ""

            if not self.get_setting(f"cmd_{cmd}", True) and cmd not in ("music", "mute"):
                return HookResult(strategy=HookStrategy.CANCEL)

            if cmd == "cute":
                if not args: return HookResult(strategy=HookStrategy.CANCEL)
                r, h, k = self._cute_settings()
                send_text(params.peer, _cute(args, r, h, k))
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "type":
                sp = args.split(" ", 1)
                if len(sp) < 2: return HookResult(strategy=HookStrategy.CANCEL)
                style, text = sp[0].lower(), sp[1]
                if style in ("bold","italic","script","fraktur","double","sans","mono","dot"):
                    send_text(params.peer, _to_style(text, style))
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "calc":
                if not args: return HookResult(strategy=HookStrategy.CANCEL)
                r = _calc_safe(args)
                send_text(params.peer, f"🧮 {args} = {r}" if r is not None else "❌ Помилка")
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "store":
                threading.Thread(target=self._show_store).start()
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "refresh":
                self.store_cache = None
                run_on_ui_thread(lambda: bulletin_success("🔄 Каталог оновлено"))
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "install":
                if not args.startswith("http"):
                    send_text(params.peer, "❌ Формат: .install <URL>")
                    return HookResult(strategy=HookStrategy.CANCEL)
                threading.Thread(target=self._download_and_open, args=(args, params.peer)).start()
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "spam":
                sp = args.split(" ", 1)
                if not sp or not sp[0]: return HookResult(strategy=HookStrategy.CANCEL)
                try: count = int(sp[0])
                except ValueError: return HookResult(strategy=HookStrategy.CANCEL)
                if count <= 0 or count > 100: return HookResult(strategy=HookStrategy.CANCEL)
                if len(sp) > 1 and sp[1].strip():
                    msg = sp[1]
                else:
                    msg = self._get_last_message_text(params.peer)
                    if not msg:
                        run_on_ui_thread(lambda: bulletin_error("Немає тексту"))
                        return HookResult(strategy=HookStrategy.CANCEL)
                self.spamming = True
                threading.Thread(target=self._do_spam, args=(params.peer, count, msg)).start()
                self.spamming = False
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "snos":
                peer = params.peer
                if peer is None or int(peer) <= 0:
                    send_text(peer, "Це не особистий чат")
                    return HookResult(strategy=HookStrategy.CANCEL)
                uid = int(peer)
                if self._my_id() == uid:
                    send_text(peer, "🤡 не можна себе")
                    return HookResult(strategy=HookStrategy.CANCEL)
                threading.Thread(target=self._do_snos_and_block, args=(peer, account)).start()
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "id":
                send_text(params.peer, f"🆔 {params.peer}")
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "coin":
                send_text(params.peer, random.choice(["🪙 Орел", "🪙 Решка"]))
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "dice":
                send_text(params.peer, f"🎲 {random.randint(1, 6)}")
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd == "random":
                sp = args.split()
                if len(sp) < 2:
                    send_text(params.peer, "❌ Формат: .random 1 100
