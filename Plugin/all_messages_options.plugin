def bulletin_info(m):
    try: BulletinHelper.show_info(f"[AMO] {m}")
    except Exception: pass

def bulletin_success(m):
    try: BulletinHelper.show_success(f"[AMO] {m}")
    except Exception: pass

def bulletin_error(m):
    try: BulletinHelper.show_error(f"[AMO] {m}")
    except Exception: pass

def _cute(text, repeats=1, add_heart=True, add_kao=True):
    text = text.strip()
    if not text: return text
    f = text[0]
    if f.isalpha():
        text = "-".join([f] * (repeats + 1)) + text[1:]
    if add_heart: text += random.choice(HEARTS)
    if add_kao: text += random.choice(KAOMOJI)
    return text

def _calc_safe(expr):
    expr = expr.strip().lower()
    for w, o in {"плюс": "+", "мінус": "-", "пі": str(math.pi), "пи": str(math.pi)}.items():
        expr = expr.replace(w, o)
    safe = "".join(c for c in expr if c in "0123456789+-*/()., sqrt%^ ")
    safe = safe.replace("^", "**").replace("sqrt", "math.sqrt")
    try: return eval(safe, {"__builtins__": {}, "math": math}, {})
    except Exception: return None

def _to_style(text, style):
    if style == "dot": return "·" + "·".join(text) + "·"
    result = []
    for ch in text:
        c = ord(ch)
        if style == "bold":
            if 65 <= c <= 90: ch = chr(0x1D400 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D41A + c - 97)
        elif style == "italic":
            if 65 <= c <= 90: ch = chr(0x1D434 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D44E + c - 97)
        elif style == "script":
            if 65 <= c <= 90: ch = chr(0x1D49C + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D4B6 + c - 97)
        elif style == "fraktur":
            if 65 <= c <= 90: ch = chr(0x1D504 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D51E + c - 97)
        elif style == "double":
            if 65 <= c <= 90: ch = chr(0x1D538 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D552 + c - 97)
        elif style == "sans":
            if 65 <= c <= 90: ch = chr(0x1D5A0 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D5BA + c - 97)
        elif style == "mono":
            if 65 <= c <= 90: ch = chr(0x1D670 + c - 65)
            elif 97 <= c <= 122: ch = chr(0x1D68A + c - 97)
        result.append(ch)
    return "".join(result)

