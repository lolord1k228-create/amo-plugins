class GetUserHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin
    def after_hooked_method(self, param):
        try:
            user = param.getResult()
            if user is None: return
            if int(user.id) in self.plugin.snosed_ids:
                user.first_name = "Deleted Account"
                user.last_name = ""
                user.username = None
                user.deleted = True
                user.premium = True
                try: user.photo = None
                except Exception: pass
        except Exception: pass

class GetBalanceHook(MethodReplacement):
    def __init__(self, plugin): self.plugin = plugin
    def replace_hooked_method(self, param):
        try:
            v = self.plugin.stars_amount
            frac = v - int(v)
            nanos = int((frac * Decimal("1000000000")).to_integral_value())
            nv = Modifier.isAbstract(TL_stars.StarsAmount.getClass().getModifiers())
            amount = TL_stars.StarsAmount.ofStars(int(v)) if nv else TL_stars.StarsAmount(int(v))
            amount.nanos = nanos
            return amount
        except Exception: return None

class InfoButtonHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin
    def after_hooked_method(self, param):
        try:
            if self.plugin.get_setting("enable_info_button", True):
                run_on_ui_thread(lambda: self.plugin._attach_info_button(param.thisObject))
        except Exception: pass

class InfoPauseHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin
    def after_hooked_method(self, param):
        try: run_on_ui_thread(self.plugin._detach_info_button)
        except Exception: pass

